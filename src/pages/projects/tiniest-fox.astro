---
import Layout from '../../layouts/Layout.astro';

const subs = [
  {
    title: 'atelier',
    description: 'A design harness where an agent draws screen options and you tweak and choose between them live.',
    tech: 'TypeScript, Node, React',
    image: { src: '/assets/tiniest-fox/atelier-gallery.png', alt: 'The atelier gallery with a control panel open on the right' },
  },
  {
    title: 'stillroom',
    description: "A home for an agent's data experiments, keeping aims, attempts and results on one read-only page.",
    tech: 'TypeScript, Node',
    image: { src: '/assets/tiniest-fox/stillroom-results.png', alt: 'A stillroom results page with an answer and a final list' },
  },
  {
    title: 'More tools coming soon',
    description: 'More tools coming soon.',
    soon: true,
  },
];
---

<Layout title="Tiniest Fox | Kippy is Online">
  <div class="k-grid">
    <div class="col-start-3 col-end-10 pt-48 pb-16">
      <div><a class="text-link-blue" href="/projects">&larr; Projects</a></div>
      <h1 class="mt-8 inline-block text-6xl lg:text-7xl font-serif font-semibold border-b-2 border-blue-500 dark:border-blue-300">Tiniest Fox</h1>
      <h2 class="text-3xl lg:text-4xl mt-8 leading-normal lg:leading-relaxed">A small collection of tools for working with AI agents, each built to do one thing well.</h2>
    </div>
  </div>
  <div class="k-grid space-y-24 lg:space-y-0 lg:gap-y-32 pb-24 lg:pb-32">
    {subs.map((s, idx) => (
      <div class={`col-span-5 ${idx % 2 !== 0 ? 'col-start-7' : ''}`}>
        <div class="h-64">
          {s.soon ? (
            <div class="h-full border-2 p-8 rounded-t-lg bg-gray-50 dark:bg-gray-800 flex items-center justify-center">
              <p class="font-serif text-4xl text-gray-400 dark:text-gray-500">Coming Soon...</p>
            </div>
          ) : (
            <div class="h-full w-full border-2 rounded-t-lg bg-white dark:bg-gray-900 overflow-hidden">
              <img class="w-full h-full object-cover object-top" src={s.image.src} alt={s.image.alt} loading="lazy" />
            </div>
          )}
        </div>
        <p class="font-semibold font-serif text-3xl lg:text-4xl mt-8">{s.title}</p>
        <p class="text-lg lg:text-2xl mt-4">{s.description}</p>
        {s.tech && <p class="font-mono text-sm text-gray-600 dark:text-gray-300 mt-4">{s.tech}</p>}
      </div>
    ))}
  </div>
</Layout>
